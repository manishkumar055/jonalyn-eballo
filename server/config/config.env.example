# Copy this file to .env in the repository root for local development.

# Application
PORT=3099
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:3000
# Optional when frontend and API are hosted separately. CRA dev uses package.json proxy.
# REACT_APP_API_URL=http://localhost:3099/api/v1

# Blockchain API
# Example: an Ethereum Sepolia RPC endpoint from your preferred provider.
BLOCKCHAIN_RPC_URL=https://sepolia.example-rpc.invalid/v1/YOUR_PROJECT_ID
BLOCKCHAIN_CHAIN_ID=11155111
# Set these after deploying or selecting the contracts you want to use.
REAL_ESTATE_CONTRACT_ADDRESS=
ESCROW_CONTRACT_ADDRESS=

# Optional legacy backend configuration
MONGO_URI=mongodb+srv://username:password@cluster.example.mongodb.net/Database
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRE=7d
COOKIE_EXPIRE=5

# Optional email / media providers used by the legacy backend
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SERVICE=smtp
SMTP_MAIL=user@example.com
SMTP_PASSWORD=replace_me
SENDGRID_API_KEY=replace_me
SENDGRID_MAIL=user@example.com
CLOUDINARY_NAME=replace_me
CLOUDINARY_API_KEY=replace_me
CLOUDINARY_API_SECRET=replace_me
